{{- /* Индекс для поиска: заметки всех разделов с тегами из всех таксономий */ -}}
{{- $docs := slice }}
{{- range where site.RegularPages "Kind" "page" }}
  {{- $tags := slice }}
  {{- range partial "post-terms.html" . }}{{ $tags = $tags | append .LinkTitle }}{{ end }}
  {{- $docs = $docs | append (dict "uri" .RelPermalink "title" .Title "content" .Plain "tags" $tags) }}
{{- end }}
{{- $docs | jsonify }}
